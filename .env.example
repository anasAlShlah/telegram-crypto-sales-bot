# ==============================================================================
# Telegram E-Commerce & Crypto Payment Bot - Environment Configuration
# ==============================================================================

# Node runtime environment (development | production | test)
NODE_ENV=development

# HTTP & Webhook listener port
PORT=3000

# Telegram Bot Token obtained from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Bot Operational Mode: 'polling' for local dev, 'webhook' for production servers
BOT_MODE=polling

# Public URL domain for receiving webhooks and checkout links
WEBHOOK_DOMAIN=http://localhost:3000
WEBHOOK_PATH=/bot/webhook

# Verified Crypto Deposit Wallets (Zero-Custody Escrow Settlement)
# BSC (BNB Smart Chain BEP-20) USDT Deposit Address
USDT_BEP20_WALLET=0x0730236b443035c3434de32263594e6bd9ce3d94

# TRON (TRC-20) USDT Deposit Address
USDT_TRC20_WALLET=TPPdHJZRFsdsu4YiqQfPkGH1L3UzwNx74N

# Comma-separated list of Telegram User IDs granted Administrator permissions
# Run /start in the bot to check your user ID, or use @userinfobot
ADMIN_TELEGRAM_IDS=123456789,987654321

# Default Tax Rate (0.05 = 5%)
TAX_RATE=0.05

# Display currency symbol
CURRENCY_SYMBOL=$

# Crypto payment countdown expiration window in minutes
CRYPTO_PAYMENT_TIMEOUT_MINUTES=60
